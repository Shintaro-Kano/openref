{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRef",
  "version": "1.0.1",
  "identifier": "dev.openref.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenRef",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "LLM 統合型ローカル文献管理",
    "copyright": "Copyright (c) 2026 Shintaro Kano — MIT License",
    "licenseFile": "../../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
